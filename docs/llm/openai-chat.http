@apiKey={{$dotenv OPENAI_API_KEY}}
@model=gpt-4o-mini
@baseURL=https://api.openai.com/v1
@uploadImage={{$dotenv UPLOAD_IMAGE}}

### Chat Completions：通常応答
POST {{ baseURL }}/chat/completions
Content-Type: application/json
Authorization: Bearer {{ apiKey }}

{
  "model": "{{ model }}",
  "messages": [
    {
      "role": "user",
      "content": "who are you?"
    }
  ]
}

### Chat Completions：ストリーミング
POST {{ baseURL }}/chat/completions
Content-Type: application/json
Authorization: Bearer {{ apiKey }}

{
  "model": "{{ model }}",
  "messages": [
    {
      "role": "user",
      "content": "who are you?"
    }
  ],
  "stream": true,
  "stream_options": { "include_usage": true }
}

### Chat Completions：画像入力
POST {{ baseURL }}/chat/completions
Content-Type: application/json
Authorization: Bearer {{ apiKey }}

{
  "model": "{{ model }}",
  "messages": [
    {
      "role": "user",
      "content": [
        {
          "type": "text",
          "text": "What is this image?"
        },
        {
          "type": "image_url",
          "image_url": {
            "url": "{{ uploadImage }}"
          }
        }
      ]
    }
  ]
}

### Chat Completions：Web 検索
POST {{ baseURL }}/chat/completions
Content-Type: application/json
Authorization: Bearer {{apiKey}}

{
  "model": "gpt-4o-mini-search-preview",
  "messages": [
    {
      "role": "user",
      "content": [
        {
          "type": "text",
          "text": "今日の「Yahoo!ニュース」で１つ内容をピックアップして"
        }
      ],
      "web_search_options": {
        "search_context_size": "low",
        "user_location": {
          "type": "approximate",
          "approximate": {
            "country": "JP"
          }
        }
      }
    }
  ]
}
