{
  "name": "pi-agent-gui",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "type": "module",
  "description": "A tiny browser GUI backed by the pi SDK.",
  "scripts": {
    "start": "pnpm --filter server start",
    "dev": "pnpm --filter server dev",
    "dev:web": "pnpm --filter client dev",
    "build": "pnpm --filter client build",
    "test": "pnpm --filter server test",
    "typecheck": "pnpm --filter server typecheck && pnpm --filter client typecheck"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1"
  }
}
