# Copy this file to .env and fill in one provider's credentials.
# The pnpm start/dev scripts load the project-root .env automatically.

# Required unless pi is already authenticated via ~/.pi/agent/auth.json.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# ZAI_API_KEY=
# MOONSHOT_API_KEY=

# Optional model/runtime settings.
# PI_MODEL=anthropic/claude-sonnet-4-5
PI_THINKING=medium
PI_APP_CWD=

# Optional server settings.
PORT=4317
HOST=127.0.0.1

# Tool execution sandbox (required for creating sessions).
# Run the sandbox in another process: pnpm start:sandbox
# PI_SANDBOX_URL=http://127.0.0.1:8080
# PI_SANDBOX_TOKEN=16+ char shared token (BFF and sandbox must match)
# PI_SANDBOX_CWD=/workspace
# SANDBOX_PORT=8080

# Optional secret-guard settings.
# 独自プロバイダーのキー変数を保護対象へ追加する（カンマ区切り）
# PI_SECRET_ENV_VARS=
