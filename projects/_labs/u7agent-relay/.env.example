# このファイルをコピーして .env を作り、検証専用の会話の実値に置き換える。
# 実値をコミットしない。

# 検証専用の u7agent 会話の HTTPS URL
U7AGENT_SESSION_URL=https://agent.example.com/s/0123456789?space=space-0123456789abcdef

# 32 文字以上の URL-safe なトークン（例: openssl rand -hex 32）
U7AGENT_RELAY_TOKEN=replace-with-a-generated-token-of-32-or-more-url-safe-characters

# 待受ポート。既定は 8787
#RELAY_PORT=8787
