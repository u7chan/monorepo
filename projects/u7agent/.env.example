# Copy this file to .env and fill in the server settings you need.
# The pnpm start/dev scripts load the project-root .env automatically.

# Provider API keys can be registered from the GUI instead of this file:
#   設定 → モデル → プロバイダーのAPIキーを入力して保存
# Registered keys are stored in the app database (<PI_SESSION_STORE>/u7agent.db)
# and are applied to the running runtime without a restart.
# Setting them here (or in ~/.pi/agent/auth.json) still works and needs a restart.
# To migrate, register the key in the GUI, confirm it survives a restart, and then
# remove that line from .env (keep the file itself if it holds other settings below).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# ZAI_API_KEY=
# MOONSHOT_API_KEY=
# XAI_API_KEY=

# Optional model/runtime settings.
# The available models and the app default model are configured in the GUI
# (設定 → モデル → 利用可能なモデル) and stored in the app database.
# PI_MODEL / PI_MODELS / PI_PROVIDER are no longer read: remove them if the
# deployment still sets them (they are ignored and reported in the GUI).
PI_THINKING=medium
PI_APP_CWD=
# Session conversation store (BFF only, never visible to the sandbox).
# Default: <pi agentDir>/u7agent/sessions. Keep it outside PI_APP_CWD.
# PI_SESSION_STORE=/var/lib/u7agent/sessions

# Optional server settings.
PORT=4317
HOST=127.0.0.1
# Preview origin (the second listener serves HTML previews on a separate origin).
# PI_FILE_PREVIEW_PORT is the port the browser uses, PI_FILE_PREVIEW_LISTEN_PORT is the listener;
# both default to 4318. Deployments publish e.g. 8017:4318 and set PI_FILE_PREVIEW_PORT=8017.
# `pnpm dev` aligns both to PI_FILE_PREVIEW_PORT (or to PI_FILE_PREVIEW_LISTEN_PORT when only that
# one is set), so `PI_FILE_PREVIEW_PORT=4319 pnpm dev` moves only the preview origin. Running a
# second `pnpm dev` side by side also needs SANDBOX_PORT and PORT, and Vite stays on 3000
# (strictPort; split it with `pnpm dev:bff` + `pnpm dev:web --port <n>`).
# Changing the port also moves the preview origin's localStorage to another origin.
# PI_FILE_PREVIEW_PORT=4318
# PI_FILE_PREVIEW_LISTEN_PORT=4318

# Tool execution sandbox (required for creating sessions; the BFF never falls back to local execution).
# `pnpm dev` starts the sandbox as a separate process with a generated token (README "ローカルで起動する（Docker なし）")
# and passes the settings below to it. This file is read by the BFF only: the sandbox needs its own CLI variables.
# PI_SANDBOX_URL=http://127.0.0.1:9418
# PI_SANDBOX_TOKEN=16+ char shared token (BFF and sandbox must match)
# PI_SANDBOX_CWD=/workspace  (local dev: a writable dir, keep it equal to PI_APP_CWD)
# SANDBOX_PORT=9418
# SANDBOX_HOST=127.0.0.1  (local dev; the code default is 0.0.0.0)

# Served app: agents listen on 0.0.0.0:8080 (one shared slot, managed through bash). The BFF forwards the
# service origin to that port over a third listener and normalizes caching headers (docs/sandbox.md).
# PI_SERVICE_LISTEN_PORT is the listener (default 4319; dev must not use 8080 because the app itself does).
# PI_SERVICE_LISTEN_PORT=4319
#
# Browser-facing link port. Unset aligns to PI_SERVICE_LISTEN_PORT; deployments publish 8016:4319 and
# set PI_PREVIEW_PORT=8016.
# PI_PREVIEW_PORT=4319

# Optional secret-guard settings.
# 独自プロバイダーのキー変数を保護対象へ追加する（カンマ区切り）
# PI_SECRET_ENV_VARS=

# 作業フォルダごとの環境変数（作業環境 → 環境変数）の「シークレット」を暗号化する master key。
# 書式は `<版>:<base64 の 32 バイト鍵>`（例: 1:$(openssl rand -base64 32)）。複数の版をカンマ区切りで並べられ、
# 新しい保存は最大の版を使う。**アプリ DB とは別経路で管理する**（同じボリュームへ置かない）。
# 未設定 / 壊れた宣言では、シークレットの登録と利用だけを 503 で拒否する（変数と起動は続く）。
# U7AGENT_SECRET_MASTER_KEY=
# 同じ内容を書いたファイルのパス（env が優先）。コンテナでは secret file のマウント先を指す。
# U7AGENT_SECRET_MASTER_KEY_FILE=
