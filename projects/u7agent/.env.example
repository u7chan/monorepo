# Copy this file to .env and fill in the server settings you need.
# The pnpm start/dev scripts load the project-root .env automatically.

# Provider API keys can be registered from the GUI instead of this file:
#   設定 → モデル → プロバイダーのAPIキーを入力して保存
# Registered keys are stored in the app database (<PI_SESSION_STORE>/u7agent.db)
# and are applied to the running runtime without a restart.
# Setting them here (or in ~/.pi/agent/auth.json) still works and needs a restart.
# To migrate, register the key in the GUI, confirm it survives a restart, and then
# remove that line from .env (keep the file itself if it holds other settings below).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# ZAI_API_KEY=
# MOONSHOT_API_KEY=
# XAI_API_KEY=

# Optional model/runtime settings.
# PI_MODEL=anthropic/claude-sonnet-4-5
PI_THINKING=medium
PI_APP_CWD=
# Session conversation store (BFF only, never visible to the sandbox).
# Default: <pi agentDir>/u7agent/sessions. Keep it outside PI_APP_CWD.
# PI_SESSION_STORE=/var/lib/u7agent/sessions
# Limit the Model picker and selection to these provider/model entries (comma separated).
# Unset shows every authenticated model. A PI_MODEL outside this list is an error, not a fallback.
# PI_MODELS=anthropic/claude-sonnet-4-5,openai/gpt-5.6-luna

# Optional server settings.
PORT=4317
HOST=127.0.0.1

# Tool execution sandbox (required for creating sessions; the BFF never falls back to local execution).
# `pnpm dev` starts the sandbox as a separate process with a generated token (README "ローカルで起動する（Docker なし）")
# and passes the settings below to it. This file is read by the BFF only: the sandbox needs its own CLI variables.
# PI_SANDBOX_URL=http://127.0.0.1:8080
# PI_SANDBOX_TOKEN=16+ char shared token (BFF and sandbox must match)
# PI_SANDBOX_CWD=/workspace  (local dev: a writable dir, keep it equal to PI_APP_CWD)
# SANDBOX_PORT=8080
# SANDBOX_HOST=127.0.0.1  (local dev; the code default is 0.0.0.0)

# Optional secret-guard settings.
# 独自プロバイダーのキー変数を保護対象へ追加する（カンマ区切り）
# PI_SECRET_ENV_VARS=
