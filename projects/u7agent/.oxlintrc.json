{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": [
    "@shadcn/lint"
  ],
  "ignorePatterns": [
    "node_modules",
    "dist"
  ],
  "plugins": [
    "typescript",
    "unicorn",
    "oxc"
  ],
  "categories": {
    "correctness": "error"
  },
  "settings": {
    "shadcn": {
      "componentImports": [
        "^\\.\\.?/"
      ]
    }
  },
  "env": {
    "builtin": true
  },
  "rules": {},
  "overrides": [
    {
      "files": [
        "client/**/*.{ts,tsx}"
      ],
      "env": {
        "browser": true
      },
      "rules": {
        "shadcn/no-raw-colors": "error",
        "shadcn/no-inline-styles": "error",
        "shadcn/no-unknown-classes": [
          "error",
          {
            "allow": [
              "md-lit"
            ]
          }
        ],
        "shadcn/require-static-classes": "error",
        "shadcn/no-arbitrary-values": [
          "error",
          {
            "allow": [
              "grid-rows-[auto_minmax(0,1fr)]",
              "grid-rows-[auto_auto_minmax(0,1fr)]",
              "grid-rows-[auto_minmax(0,1fr)_auto]",
              "grid-rows-[auto_auto_minmax(0,1fr)_auto]",
              "grid-rows-[auto_auto_auto_minmax(0,1fr)_auto]",
              "grid-rows-[minmax(0,1fr)_auto]",
              "grid-cols-[auto_minmax(0,1fr)]",
              "grid-cols-[248px_minmax(0,1fr)]",
              "grid-cols-[352px_minmax(0,1fr)]",
              "grid-cols-[var(--sidebar-width)_minmax(0,1fr)]",
              "grid-cols-[minmax(0,1fr)_min(360px,30vw)]",
              "grid-cols-[minmax(0,1fr)_var(--session-files-width)]",
              "grid-cols-[minmax(0,1fr)_minmax(400px,460px)]",
              "left-[calc(var(--file-tree-width)_-_4px)]",
              "aspect-[16/10]",
              "max-h-[42dvh]",
              "max-h-[min(88dvh,760px)]",
              "max-w-[88%]",
              "max-w-[min(10rem,100%)]",
              "max-w-[min(760px,86%)]",
              "w-[3.25em]",
              "w-[min(320px,86vw)]",
              "w-[min(420px,92vw)]",
              "w-[min(560px,92vw)]",
              "pt-[8vh]",
              "pt-[18vh]",
              "pb-[max(8px,env(safe-area-inset-bottom))]",
              "transition-[opacity,color]"
            ]
          }
        ],
        "shadcn/no-restyle": [
          "error",
          {
            "allow": [
              "layout"
            ]
          }
        ],
        "no-restricted-globals": [
          "error",
          {
            "name": "confirm",
            "message": "\u78ba\u8a8d\u306f\u5171\u901a\u306e ConfirmDialog (useConfirm) \u3092\u901a\u3059"
          },
          {
            "name": "prompt",
            "message": "\u5165\u529b\u306f\u5171\u901a\u306e ConfirmDialog (usePrompt) \u3092\u901a\u3059"
          },
          {
            "name": "alert",
            "message": "\u901a\u77e5\u306f\u753b\u9762\u5185\u306e\u8868\u793a\u3067\u51fa\u3059"
          }
        ],
        "no-restricted-properties": [
          "error",
          {
            "object": "window",
            "property": "confirm",
            "message": "\u78ba\u8a8d\u306f\u5171\u901a\u306e ConfirmDialog (useConfirm) \u3092\u901a\u3059"
          },
          {
            "object": "window",
            "property": "prompt",
            "message": "\u5165\u529b\u306f\u5171\u901a\u306e ConfirmDialog (usePrompt) \u3092\u901a\u3059"
          },
          {
            "object": "globalThis",
            "property": "confirm",
            "message": "\u78ba\u8a8d\u306f\u5171\u901a\u306e ConfirmDialog (useConfirm) \u3092\u901a\u3059"
          },
          {
            "object": "globalThis",
            "property": "prompt",
            "message": "\u5165\u529b\u306f\u5171\u901a\u306e ConfirmDialog (usePrompt) \u3092\u901a\u3059"
          },
          {
            "object": "window",
            "property": "alert",
            "message": "\u901a\u77e5\u306f\u753b\u9762\u5185\u306e\u8868\u793a\u3067\u51fa\u3059"
          },
          {
            "object": "globalThis",
            "property": "alert",
            "message": "\u901a\u77e5\u306f\u753b\u9762\u5185\u306e\u8868\u793a\u3067\u51fa\u3059"
          }
        ]
      }
    },
    {
      "files": [
        "server/**/*.{ts,tsx}"
      ],
      "env": {
        "node": true
      },
      "rules": {
        "shadcn/no-raw-colors": "off",
        "shadcn/no-inline-styles": "off",
        "shadcn/no-unknown-classes": "off",
        "shadcn/require-static-classes": "off",
        "shadcn/no-arbitrary-values": "off",
        "shadcn/no-restyle": "off"
      }
    },
    {
      "files": [
        "server/src/wait-total.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "*"
                ],
                "message": "client \u306e bundle \u306b server \u306e\u4f9d\u5b58\u3092\u5165\u308c\u306a\u3044\u305f\u3081 import \u3092\u6301\u305f\u305b\u306a\u3044"
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "client/**/*.{ts,tsx}"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "server",
                "allowTypeImports": true,
                "message": "\u30eb\u30fc\u30c8\u7d4c\u7531\u306f node:sqlite \u3092 client bundle \u306b\u5165\u308c\u308b\u3002runtime \u3067\u4f7f\u3046\u5024\u306f server/wait-total \u304b\u3089\u53d6\u308b"
              }
            ],
            "patterns": [
              {
                "group": [
                  "server/*",
                  "!server/wait-total"
                ],
                "allowTypeImports": true,
                "message": "client \u304c runtime \u3067\u4f7f\u3046\u306e\u306f server/wait-total \u3060\u3051"
              }
            ]
          }
        ]
      }
    }
  ]
}
