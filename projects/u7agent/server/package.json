{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "dev:sandbox": "tsx watch src/sandbox/index.ts",
    "start:sandbox": "tsx src/sandbox/index.ts",
    "browser": "node --import tsx src/browser/cli.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/zod-validator": "^0.9.1",
    "hono": "^4.13.14",
    "playwright-core": "1.64.1",
    "tsx": "^4.23.15",
    "yaml": ">=2.9.0 <3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "exports": {
    ".": "./src/app.ts"
  }
}
