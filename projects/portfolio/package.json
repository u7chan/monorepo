{
  "name": "portfolio",
  "type": "module",
  "scripts": {
    "dev": "dotenv -- vite --mode dev --host 0.0.0.0",
    "typegen": "vite build --mode typegen",
    "build": "vite build",
    "start": "NODE_ENV=production dotenv -- bunx tsx ./src/server/node-server.ts",
    "test": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --no-experimental-webstorage\" vitest run",
    "test:watch": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --no-experimental-webstorage\" vitest",
    "test:coverage": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --no-experimental-webstorage\" vitest run --coverage",
    "lint": "bun ./node_modules/typescript/bin/tsc && oxlint",
    "lint:fix": "oxlint --fix",
    "format:check": "oxfmt --check",
    "format": "oxfmt",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:user:add": "dotenv -- bun run src/db/seeders/add-user.ts",
    "db:prompt-templates:seed": "dotenv -- bun run src/db/seeders/seed-prompt-templates.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@hono/standard-validator": "^0.4.0",
    "@hono/structured-logger": "^0.1.0",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "crypto-js": "^4.2.0",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "monaco-editor": "^0.57.0",
    "openai": "^6.49.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "react": "^19.3.0",
    "react-diff-viewer": "^3.1.1",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-sanitize": "^6.0.0",
    "remark-cjk-friendly": "^2.3.2",
    "remark-cjk-friendly-gfm-strikethrough": "^2.3.1",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.15",
    "uuidv7": "^1.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@hono/vite-dev-server": "^0.26.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-plugin": "^1.168.42",
    "@testing-library/react": "^16.3.3",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^24.13.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/coverage-v8": "^5.0.3",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^30.1.2",
    "oxfmt": "0.72.0",
    "oxlint": "^1.87.0",
    "pino-pretty": "^13.2.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.3"
  }
}
