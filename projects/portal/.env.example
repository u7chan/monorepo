# Portal Environment Variables

# Host for port links (default: localhost)
# Use this when accessing Docker containers on a remote host
PORTAL_HOST=localhost

# Port links default to http://<PORTAL_HOST>:<port>.
# Override a link per published port with the Docker label
# `portal.url.<port>` (e.g. portal.url.443=https://portal.home.arpa).

# Enable mock data mode for testing without Docker
# Set to "true" to use mock container data
USE_MOCK_DATA=false

# Node environment (development/production)
NODE_ENV=development

# Fine-grained PAT for workflow dispatch. Required permission: Actions write on
# u7chan/self-hosted-runner. Read only by the server. Keep it in the host-side
# .env; never commit it.
PORTAL_GITHUB_TOKEN=

# Classic PAT with read:packages for the GHCR tag list. GitHub Packages and
# the container registry do not support fine-grained PATs for this endpoint.
PORTAL_GHCR_TOKEN=
