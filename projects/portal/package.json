{
  "name": "portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "dev:mock": "USE_MOCK_DATA=true bun --hot src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "start:mock": "USE_MOCK_DATA=true NODE_ENV=production bun src/index.ts",
    "lint": "tsc --noEmit && oxlint .",
    "lint:fix": "oxlint . --fix",
    "test": "bun test",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check"
  },
  "dependencies": {
    "bun-plugin-tailwind": "^0.1.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "typescript": "^7.0.2"
  }
}
