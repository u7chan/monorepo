# このプロジェクトの環境変数。`bun run dev` / `bun run start` は同じディレクトリの .env を自動で読む。

# HTTP の待ち受け
HOST=0.0.0.0
PORT=3000

# SQLite と認証状態（pin-hash / session-key）の置き場。起動時に 0700 で作り、配下のファイルを 0600 にする
DATA_DIR=./data

# Codex の資格情報（auth.json / device-id）と OpenCode Go のアカウント（opencode-accounts.json）の置き場。
# 起動時に 0700、配下のファイルを 0600 にする
CREDENTIAL_DIR=./credentials

# 画面から設定していない provider の取得間隔（ms）。画面から選べるのは 5 分以上
# POLL_INTERVAL_MS=600000

# build 時に埋め込む。未設定なら package.json の version を User-Agent に使う
# COMMIT_HASH=

# 前段（Caddy など）で TLS を終端するときは 1。X-Forwarded-Proto / Host / For を信頼する
# TRUST_PROXY=1

# 1 なら cookie に常に Secure を付ける。auto は HTTPS の要求（TRUST_PROXY=1 なら転送ヘッダーも見る）だけ
# COOKIE_SECURE=auto
