# このプロジェクトの環境変数。`bun run dev` / `bun run start` は同じディレクトリの `.env` を自動で読む。

# HTTP の待ち受け
HOST=0.0.0.0
PORT=3000

# SQLite の置き場。起動時に 0700 で作り、配下の usage.sqlite を 0600 にする
DATA_DIR=./data

# `$argon2id$...` を base64url にした PIN ハッシュ（作り方は docs/design.md）
PIN_HASH_B64=

# セッション cookie の署名鍵（base64url で 32 bytes）
SESSION_SECRET=

# build 時に埋め込む。未設定なら package.json の version を User-Agent に使う
# COMMIT_HASH=
