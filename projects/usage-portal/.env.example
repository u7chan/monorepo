# このプロジェクトの環境変数。`bun run dev` / `bun run start` は同じディレクトリの .env を自動で読む。

# HTTP の待ち受け
HOST=0.0.0.0
PORT=3000

# SQLite と認証状態（pin-hash / session-key）の置き場。起動時に 0700 で作り、配下のファイルを 0600 にする
DATA_DIR=./data

# Codex の資格情報（auth.json / device-id）の置き場。起動時に 0700、配下のファイルを 0600 にする
CREDENTIAL_DIR=./credentials

# 上流を取りに行く間隔（ms）。1 分未満は受け付けない
# POLL_INTERVAL_MS=300000

# build 時に埋め込む。未設定なら package.json の version を User-Agent に使う
# COMMIT_HASH=
