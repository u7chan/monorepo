{
  "name": "usage-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/server.ts",
    "start": "bun src/server.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test scripts",
    "fmt": "oxfmt src test scripts",
    "fmt:check": "oxfmt --check src test scripts",
    "docs:check": "bun scripts/docs-check.mjs",
    "check": "bun run lint && bun run fmt:check && bun run typecheck && bun run test && bun run docs:check"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "preact": "^11.0.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "oxfmt": "0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2"
  }
}
